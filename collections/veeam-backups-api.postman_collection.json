    {
      "id": "c421edbf-9968-4130-8cfe-a2fc93dea44d",
      "name": "Backups",
      "description": {
        "content": "The Backups section defines paths and operations for managing backups that are created on or imported to the backup server.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "2cff1f08-7047-4cd4-a517-e1f3e6ca1f09",
          "name": "Get All Backups",
          "request": {
            "name": "Get All Backups",
            "description": {
              "content": "The HTTP GET request to the `/api/v1/backups` path allows you to get an array of all backups that are created on or imported to the backup server.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "backups"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "skip",
                  "value": "<integer>",
                  "description": "Number of backups to skip."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Maximum number of backups to return."
                },
                {
                  "disabled": false,
                  "key": "orderColumn",
                  "value": "<string>",
                  "description": "Sorts backups by one of the backup parameters."
                },
                {
                  "disabled": false,
                  "key": "orderAsc",
                  "value": "<boolean>",
                  "description": "Sorts backups in the ascending order by the `orderColumn` parameter."
                },
                {
                  "disabled": false,
                  "key": "nameFilter",
                  "value": "<string>",
                  "description": "Filters backups by the `nameFilter` pattern. The pattern can match any backup parameter. To substitute one or more characters, use the asterisk (*) character at the beginning, at the end or both."
                },
                {
                  "disabled": false,
                  "key": "createdAfterFilter",
                  "value": "<dateTime>",
                  "description": "Returns backups that are created after the specified date and time."
                },
                {
                  "disabled": false,
                  "key": "createdBeforeFilter",
                  "value": "<dateTime>",
                  "description": "Returns backups that are created before the specified date and time."
                },
                {
                  "disabled": false,
                  "key": "platformIdFilter",
                  "value": "<uuid>",
                  "description": "Filters backups by ID of the backup object platform."
                },
                {
                  "disabled": false,
                  "key": "jobIdFilter",
                  "value": "<uuid>",
                  "description": "Filters backups by ID of the parent job."
                },
                {
                  "disabled": false,
                  "key": "policyTagFilter",
                  "value": "<string>",
                  "description": "Filters backups by retention policy tag."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
