        {
          "id": "645da8f2-ac16-40da-a548-d8220561ee49",
          "name": "Get VMware vSphere Server Objects",
          "request": {
            "name": "Get VMware vSphere Server Objects",
            "description": {
              "content": "The HTTP GET request to the `/api/v1/inventory/vmware/hosts/{name}` path allows you to get an array of virtual infrastructure objects of the VMware vSphere server that has the specified `name`.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "inventory",
                "vmware",
                "hosts",
                ":name"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "skip",
                  "value": "<integer>",
                  "description": "Number of objects to skip."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Maximum number of objects to return."
                },
                {
                  "disabled": false,
                  "key": "orderColumn",
                  "value": "<string>",
                  "description": "Sorts objects by one of the object parameters."
                },
                {
                  "disabled": false,
                  "key": "orderAsc",
                  "value": "<boolean>",
                  "description": "Sorts objects in the ascending order by the `orderColumn` parameter."
                },
                {
                  "disabled": false,
                  "key": "objectIdFilter",
                  "value": "<string>",
                  "description": "Filters objects by object ID."
                },
                {
                  "disabled": false,
                  "key": "hierarchyTypeFilter",
                  "value": "<string>",
                  "description": "Filters objects by hierarchy type."
                },
                {
                  "disabled": false,
                  "key": "nameFilter",
                  "value": "<string>",
                  "description": "Filters objects by the `nameFilter` pattern. The pattern can match any object parameter. To substitute one or more characters, use the asterisk (*) character at the beginning, at the end or both."
                },
                {
                  "disabled": false,
                  "key": "typeFilter",
                  "value": "<string>",
                  "description": "Filters objects by virtual infrastructure type."
                },
                {
                  "disabled": false,
                  "key": "parentContainerNameFilter",
                  "value": "<string>",
                  "description": "Filters objects by name of the parent container."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "name",
                  "description": "(Required) Name of the VMware vSphere server."
