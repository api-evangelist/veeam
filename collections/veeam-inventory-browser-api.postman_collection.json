  "item": [
    {
      "id": "7fcfabc0-0506-4e3e-b4d7-eecdbe2c757a",
      "name": "Inventory Browser",
      "description": {
        "content": "The Inventory Browser section defines paths and operations for retrieving VMware vSphere servers and their virtual infrastructure objects (data centers, clusters, hosts, resource pools, VMs).<br> <div class=\"note\"><strong>NOTE</strong><br>In the current version, you can browse VMware vSphere objects only.</div>",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "946a9662-b80b-407e-921f-21a469271515",
          "name": "Get All VMware vSphere Servers",
          "request": {
            "name": "Get All VMware vSphere Servers",
            "description": {
              "content": "The HTTP GET request to the `/api/v1/inventory/vmware/hosts` path allows you to get an array of all VMware vSphere servers added to the backup infrastructure.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "inventory",
                "vmware",
                "hosts"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "skip",
                  "value": "<integer>",
                  "description": "Number of VMware vSphere servers to skip."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Maximum number of VMware vSphere servers to return."
                },
                {
                  "disabled": false,
                  "key": "orderColumn",
                  "value": "<string>",
                  "description": "Sorts VMware vSphere servers by one of the VMware vSphere server parameters."
                },
                {
                  "disabled": false,
                  "key": "orderAsc",
                  "value": "<boolean>",
                  "description": "Sorts VMware vSphere servers in the ascending order by the `orderColumn` parameter."
                },
                {
                  "disabled": false,
                  "key": "nameFilter",
                  "value": "<string>",
                  "description": "Filters VMware vSphere servers by the `nameFilter` pattern. The pattern can match any VMware vSphere server parameter. To substitute one or more characters, use the asterisk (*) character at the beginning and/or at the end."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Version and revision of the client REST API. Must be in the following format&#58; `<version>-<revision>`.",
