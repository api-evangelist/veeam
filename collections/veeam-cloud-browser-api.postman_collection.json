      "name": "Cloud Browser",
      "description": {
        "content": "The Cloud Browser section defines paths and operations for retrieving information about cloud resources (compute or storage). Cloud browser helps you map a cloud folder with an object storage repository.",
        "type": "text/plain"
      },
