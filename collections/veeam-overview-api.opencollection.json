{
  "opencollection": "1.0.0",
  "info": {
    "name": "Veeam Backup for AWS public API 1.0 Agents Overview API",
    "version": "1.0-rev0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Overview",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "UserStatus",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/userStatus",
            "headers": [
              {
                "name": "x-api-version",
                "value": ""
              }
            ]
          }
        }
      ]
    }
  ],
  "bundled": true
}