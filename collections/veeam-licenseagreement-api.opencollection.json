{
  "opencollection": "1.0.0",
  "info": {
    "name": "Veeam Backup for AWS public API 1.0 Agents LicenseAgreement API",
    "version": "1.0-rev0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "LicenseAgreement",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GetLicenseAgreement",
