              },
              {
                "name": "thirdPartyLicenseAgreementChecksum",
                "value": "",
                "type": "query"
              }
            ]
          }
        },
        {
          "info": {
            "name": "DownloadLicenseAgreementFile",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/licenseAgreement/download",
            "headers": [
              {
                "name": "x-api-version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "licenseAgreementType",
                "value": "",
                "type": "query"
              }
            ]
          }
        }
      ]
    }
  ],
  "bundled": true
}