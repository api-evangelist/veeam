              }
            ]
          }
        },
        {
          "info": {
            "name": "GetCurrentLicenseAgreementAccepted",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/licenseAgreement/accepted",
            "headers": [
              {
                "name": "x-api-version",
                "value": ""
              }
            ]
          }
        },
        {
          "info": {
            "name": "AcceptLicenseAgreement",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/licenseAgreement/accept",
            "headers": [
              {
                "name": "x-api-version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "eulaChecksum",
                "value": "",
