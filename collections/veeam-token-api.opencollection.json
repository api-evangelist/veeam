{
  "opencollection": "1.0.0",
  "info": {
    "name": "Veeam Backup for AWS public API 1.0 Agents Token API",
    "version": "1.0-rev0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Token",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Authenticate",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/token",
            "headers": [
              {
                "name": "x-api-version",
                "value": ""
              }
            ],
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "grant_type",
                  "value": ""
                },
                {
                  "name": "username",
                  "value": ""
                },
                {
                  "name": "password",
                  "value": ""
                },
                {
                  "name": "refresh_token",
                  "value": ""
                },
                {
                  "name": "code",
                  "value": ""
                },
                {
                  "name": "mfa_token",
                  "value": ""
                },
                {
                  "name": "mfa_code",
                  "value": ""
                }
              ]
            }
          }
        },
        {
          "info": {
            "name": "SignOut",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/token",
            "headers": [
              {
                "name": "x-api-version",
                "value": ""
              }
            ]
          }
        },
        {
          "info": {
            "name": "CreateAuthorizationCode",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/token/authorizationCode",
            "headers": [
              {
                "name": "x-api-version",
                "value": ""
              }
            ]
          }
        }
      ]
    }
  ],
  "bundled": true
}