{
  "opencollection": "1.0.0",
  "info": {
    "name": "Veeam Backup for AWS public API 1.0 Agents System API",
    "version": "1.0-rev0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "System",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GetSystemLogs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/system/logs",
            "headers": [
              {
                "name": "x-api-version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "ExportLogsType",
                "value": "",
                "type": "query"
              },
              {
                "name": "Days",
                "value": "",
                "type": "query"
              },
              {
                "name": "FromDateUtc",
                "value": "",
                "type": "query"
              },
              {
                "name": "ToDateUtc",
                "value": "",
                "type": "query"
              }
            ]
          }
        },
        {
          "info": {
            "name": "GetSystemDateTimeInfo",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/system/time",
            "headers": [
              {
                "name": "x-api-version",
                "value": ""
              }
            ]
          }
        }
      ]
    }
  ],
  "bundled": true
}