{
  "opencollection": "1.0.0",
  "info": {
    "name": "Veeam Backup for AWS public API 1.0 Agents Certificates API",
    "version": "1.0-rev0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Certificates",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GetCertificates",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/settings/certificates",
            "headers": [
              {
                "name": "x-api-version",
                "value": ""
              }
            ]
          }
        },
        {
          "info": {
            "name": "RecreateCertificate",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/settings/certificates/regenerate",
            "headers": [
              {
                "name": "x-api-version",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
            "name": "UploadCertificate",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/settings/certificates/upload",
            "headers": [
              {
                "name": "x-api-version",
                "value": ""
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "certificateFile",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "certificatePassword",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          }
        }
      ]
    }
  ],
  "bundled": true
}