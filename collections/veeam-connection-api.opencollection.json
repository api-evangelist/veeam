{
  "opencollection": "1.0.0",
  "info": {
    "name": "Veeam Backup for AWS public API 1.0 Agents Connection API",
    "version": "1.0-rev0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Connection",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Request TLS Certificate or SSH Fingerprint",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/connectionCertificate",
            "headers": [
              {
                "name": "x-api-version",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "The HTTP POST request to the `/api/v1/connectionCertificate` path allows you to get a TLS certificate or SSH fingerprint of the specified host."
        }
      ]
    }
  ],
  "bundled": true
}