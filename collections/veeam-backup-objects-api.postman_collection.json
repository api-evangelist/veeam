  "item": [
    {
      "id": "55aab589-5e94-4f36-a460-26dce497ce35",
      "name": "Backup Objects",
      "description": {
        "content": "The Backup Objects section defines paths and operations for managing backup objects — virtual infrastructure objects (VMs and VM containers) that are included in backups created by the backup server.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "02a22453-1099-4246-911b-c27816ecdacb",
          "name": "Get All Backup Objects",
          "request": {
            "name": "Get All Backup Objects",
            "description": {
              "content": "The HTTP GET request to the `/api/v1/backupObjects` path allows you to get an array of virtual infrastructure objects (VMs and VM containers) that are included in backups created by the backup server.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "backupObjects"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "skip",
                  "value": "<integer>",
                  "description": "Number of backup objects to skip."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Maximum number of backup objects to return."
                },
                {
                  "disabled": false,
                  "key": "orderColumn",
                  "value": "<string>",
                  "description": "Sorts backup objects by one of the backup object parameters."
                },
                {
                  "disabled": false,
                  "key": "orderAsc",
                  "value": "<boolean>",
                  "description": "Sorts backup objects in the ascending order by the `orderColumn` parameter."
                },
                {
                  "disabled": false,
                  "key": "nameFilter",
                  "value": "<string>",
                  "description": "Filters backup objects by the `nameFilter` pattern. The pattern can match any backup object parameter. To substitute one or more characters, use the asterisk (*) character at the beginning and/or at the end."
                },
                {
                  "disabled": false,
                  "key": "platformNameFilter",
                  "value": "<string>",
                  "description": "Filters backup objects by platform ID."
                },
                {
                  "disabled": false,
                  "key": "platformIdFilter",
                  "value": "<uuid>",
                  "description": "Filters backup objects by platform ID."
                },
                {
                  "disabled": false,
                  "key": "typeFilter",
                  "value": "<string>",
                  "description": "Filters backup objects by object type."
                },
                {
                  "disabled": false,
                  "key": "viTypeFilter",
                  "value": "<string>",
                  "description": "Filters backup objects by the type of VMware vSphere server."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
